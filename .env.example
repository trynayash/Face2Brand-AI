# Example environment variables for Face2BrandAI

# Clerk API Key (Frontend)
VITE_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key # Used for Clerk authentication in frontend
CLERK_SECRET_KEY=your-clerk-secret-key

# Supabase Project URL
VITE_SUPABASE_URL=your-supabase-url # Used for Supabase client in frontend
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Supabase Public Anon Key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key # Used for Supabase client in frontend

# OpenRouter API Key (Frontend)
VITE_OPENROUTER_API_KEY=your-openrouter-api-key # Used for OpenRouter LLM API calls in frontend

# Google Cloud Vision API Key (Backend)
GOOGLE_CLOUD_VISION_API_KEY=your-google-cloud-vision-api-key # Used for Vision API proxy in backend

# (Optional) CORS origins for backend
CORS_ORIGINS=http://localhost:5173,https://your-vercel-domain.vercel.app

# Server Port (Backend, optional)
PORT=4000 # Port for Express server (default: 4000) 